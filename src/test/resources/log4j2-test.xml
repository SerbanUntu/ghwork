<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %highlight{%-5level} %logger{2} - %msg%n"/>
        </Console>
        <List name="ListAppender"/>
    </Appenders>
    <Loggers>
        <Logger name="com.ghwork" level="DEBUG"/>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ListAppender"/>
        </Root>
    </Loggers>
</Configuration>
